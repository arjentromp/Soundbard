<Window
    x:Class="Soundbard.Views.ManageAudioDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Soundbard.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Manage Audio"
    Width="420"
    Height="580"
    Background="#1f1d1b"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:FilePathToNameConverter x:Key="FilePathToNameConverter" />
    </Window.Resources>
    <Border
        Background="#262422"
        BorderBrush="#3b3734"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <TextBlock
                Grid.Row="0"
                Margin="0,5,0,0"
                FontFamily="pack://application:,,,/Fonts/#Cinzel"
                FontSize="20"
                Foreground="White"
                Text="Manage Audio"
                TextAlignment="Center" />

            <!--  File list  -->
            <ScrollViewer
                Grid.Row="1"
                Margin="16,12,16,0"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilePaths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Padding="8,6"
                                    Background="#1f1d1b"
                                    BorderBrush="#3b3734"
                                    BorderThickness="1">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="White"
                                        Text="{Binding Converter={StaticResource FilePathToNameConverter}}" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Click="MoveUp_Click"
                                        Content="↑"
                                        FontSize="20"
                                        Foreground="Green"
                                        Style="{StaticResource TitleBarButton}"
                                        Tag="{Binding}" />
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Click="MoveDown_Click"
                                        Content="↓"
                                        FontSize="20"
                                        Foreground="Red"
                                        Style="{StaticResource TitleBarButton}"
                                        Tag="{Binding}" />
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,8,0"
                                        Click="Delete_Click"
                                        Content="🗑"
                                        Foreground="White"
                                        Style="{StaticResource TitleBarButton}"
                                        Tag="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  Footer  -->
            <Button
                Grid.Row="2"
                Padding="5"
                Click="Close_Click"
                Content="Close"
                FontSize="15"
                Style="{StaticResource TitleBarButton}" />
        </Grid>
    </Border>
</Window>