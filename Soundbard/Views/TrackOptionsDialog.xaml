<Window
    x:Class="Soundbard.Views.TrackOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Soundbard.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Add Track"
    Width="420"
    Height="580"
    Background="#1f1d1b"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  Checkbox  -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                x:Name="box"
                                Width="28"
                                Height="28"
                                Background="#1f1d1b"
                                BorderBrush="#3b3734"
                                BorderThickness="1">
                                <TextBlock
                                    x:Name="check"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="19"
                                    Foreground="#af9241"
                                    Text="✓"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="box" Property="BorderBrush" Value="#af9241" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#af9241" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Dropdown  -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1f1d1b" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3b3734" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                                x:Name="PART_ToggleButton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="border"
                                            Padding="8,6"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Foreground="#7a7060"
                                                    Text="▾" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#af9241" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#af9241" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    TextElement.Foreground="White" />
                            </ToggleButton>
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="None">
                                <Border
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    Background="#1f1d1b"
                                    BorderBrush="#3b3734"
                                    BorderThickness="1">
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border
                                        x:Name="itemBorder"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#3c3116" />
                                            <Setter Property="Foreground" Value="#af9241" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#3c3116" />
                                            <Setter Property="Foreground" Value="#af9241" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Textbox style  -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1f1d1b" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3b3734" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#af9241" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#af9241" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Color button style  -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!--  End of resources  -->
    <Border
        Background="#262422"
        BorderBrush="#3b3734"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <TextBlock
                Grid.Row="0"
                Margin="0,5,0,0"
                FontFamily="pack://application:,,,/Fonts/#Cinzel"
                FontSize="20"
                Foreground="White"
                Text="Track options"
                TextAlignment="Center" />

            <!--  Form will go here  -->
            <StackPanel Grid.Row="1" Margin="16,12,16,0">
                <!--  Track Name  -->
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="14"
                    Foreground="White"
                    Text="Track name" />
                <TextBox
                    x:Name="TrackNameBox"
                    Padding="3"
                    Background="#1f1d1b"
                    BorderBrush="#3b3734"
                    BorderThickness="1"
                    CaretBrush="White"
                    FontSize="12"
                    Foreground="White"
                    Text="New Track" />
                <!--  Hotkey  -->
                <TextBlock
                    Margin="0,12,0,4"
                    FontSize="14"
                    Foreground="White"
                    Text="Hotkey" />
                <Border
                    x:Name="HotkeyBorder"
                    Padding="8,6"
                    Background="#1f1d1b"
                    BorderBrush="#3b3734"
                    BorderThickness="1"
                    Cursor="Hand"
                    MouseDown="HotkeyBorder_MouseDown">
                    <TextBlock
                        x:Name="HotkeyDisplay"
                        Focusable="True"
                        FontSize="12"
                        Foreground="#7a7060"
                        KeyDown="HotkeyDisplay_KeyDown"
                        Text="Click to assign..." />
                </Border>
                <!--  Border Colour  -->
                <TextBlock
                    Margin="0,12,0,4"
                    FontSize="14"
                    Foreground="White"
                    Text="Border color" />
                <Grid x:Name="SwatchPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Margin="4"
                        Background="#c0392b"
                        Click="Swatch_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#c0392b" />
                    <Button
                        Grid.Column="1"
                        Margin="4"
                        Background="#e67e22"
                        Click="Swatch_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#e67e22" />
                    <Button
                        Grid.Column="2"
                        Margin="4"
                        Background="#f1c40f"
                        Click="Swatch_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#f1c40f" />
                    <Button
                        Grid.Column="3"
                        Margin="4"
                        Background="#27ae60"
                        Click="Swatch_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#27ae60" />
                    <Button
                        Grid.Column="4"
                        Margin="4"
                        Background="#1abc9c"
                        Click="Swatch_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#1abc9c" />
                    <Button
                        Grid.Column="5"
                        Margin="4"
                        Background="#2980b9"
                        Click="Swatch_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#2980b9" />
                    <Button
                        Grid.Column="6"
                        Margin="4"
                        Background="#8e44ad"
                        Click="Swatch_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#8e44ad" />
                    <Button
                        Grid.Column="7"
                        Margin="4"
                        Background="#e91e8c"
                        Click="Swatch_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#e91e8c" />
                    <Button
                        Grid.Column="8"
                        Margin="4"
                        Background="#95a5a6"
                        Click="Swatch_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#95a5a6" />
                    <Button
                        Grid.Column="9"
                        Margin="4"
                        Background="#af9241"
                        Click="Swatch_Click"
                        Style="{StaticResource SwatchButton}"
                        Tag="#af9241" />
                </Grid>
                <TextBlock
                    Margin="0,12,0,4"
                    FontSize="14"
                    Foreground="White"
                    Text="Play mode" />
                <ComboBox
                    x:Name="PlayModeBox"
                    Foreground="White"
                    SelectedIndex="0">
                    <ComboBoxItem
                        Content="Select play mode..."
                        Foreground="#7a7060"
                        IsEnabled="False" />
                    <ComboBoxItem Content="Continuous" />
                    <ComboBoxItem Content="Manual" />
                    <ComboBoxItem Content="Interval" />
                </ComboBox>
                <TextBlock
                    Margin="0,12,0,4"
                    FontSize="14"
                    Foreground="White"
                    Text="Queue mode" />
                <ComboBox
                    x:Name="QueueModeBox"
                    Foreground="White"
                    SelectedIndex="0">
                    <ComboBoxItem
                        Content="Select queue mode..."
                        Foreground="#7a7060"
                        IsEnabled="False" />
                    <ComboBoxItem Content="Shuffle" />
                    <ComboBoxItem Content="Sequential" />
                    <ComboBoxItem Content="Custom" />
                </ComboBox>
                <!--  Fade  -->
                <TextBlock
                    Margin="0,12,0,4"
                    FontSize="14"
                    Foreground="White"
                    Text="Fade" />
                <StackPanel Orientation="Horizontal">
                    <CheckBox
                        x:Name="FadeEnabledBox"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Foreground="White" />
                    <TextBox
                        x:Name="FadeDurationBox"
                        Width="60"
                        Padding="3"
                        Text="2" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#7a7060"
                        Text="seconds" />
                </StackPanel>
                <TextBlock
                    Margin="0,12,0,4"
                    FontSize="14"
                    Foreground="White"
                    Text="Interval" />
                <StackPanel Orientation="Horizontal">
                    <CheckBox
                        x:Name="IntervalEnabledBox"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Foreground="White" />
                    <TextBox
                        x:Name="IntervalDurationBox"
                        Width="60"
                        Padding="3"
                        Text="2" />
                    <TextBlock
                        Margin="8,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#7a7060"
                        Text="seconds" />
                    <TextBox
                        x:Name="IntervalDeviationBox"
                        Width="60"
                        Padding="3"
                        Text="2" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#7a7060"
                        Text="Deviation" />
                </StackPanel>
            </StackPanel>

            <!--  Footer buttons will go here  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Padding="5"
                    Click="Confirm_Click"
                    Content="Confirm"
                    FontSize="15"
                    Style="{StaticResource TitleBarButton}" />
                <Button
                    Grid.Column="1"
                    Padding="5"
                    Click="Cancel_Click"
                    Content="Cancel"
                    FontSize="15"
                    Style="{StaticResource TitleBarButton}" />
            </Grid>

        </Grid>
    </Border>
</Window>
