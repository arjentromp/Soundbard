<Window x:Class="Soundbard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Soundbard"
        mc:Ignorable="d" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="MainWindow" Height="800" Width="1500"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <!-- Grid definitions for header and window -->
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#FF1F1F1F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="SoundBard" VerticalAlignment="Center"
                       Foreground="White" Margin="20,0,0,0" FontSize="16"/>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="btnMinimize" Content="➖" Width="45" Height="35"
                        BorderBrush="Transparent" Background="Transparent"
                        Foreground="White" FontSize="15" Cursor="Hand"
                        Click="btnMinimize_Click"/>
                <Button x:Name="btnMaximize" Content="🗖" Width="45" Height="35"
                        BorderBrush="Transparent" Background="Transparent"
                        Foreground="White" FontSize="15" Cursor="Hand"
                        Click="btnMaximize_Click"/>
                <Button x:Name="btnClose" Content="❌" Width="45" Height="35"
                        BorderBrush="Transparent" Background="Transparent"
                        Foreground="White" FontSize="15" Cursor="Hand"
                        Click="btnClose_Click"/>
            </StackPanel>
        </Grid>
        
        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- Grid definitions for Menu, Foldertree and Workspace -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="5*" MinWidth="130" MaxWidth="850"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="18*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Menu -->
            <StackPanel Grid.Column="0" Background="#FF1F1F1F">
                <Button x:Name="btnSave" Content="💾" Height="40" Cursor="Hand"
                        Background="Transparent" BorderBrush="Transparent" Foreground="White"/>
                <Button x:Name="btnLoad" Content="📂" Height="40" Cursor="Hand"
                        Background="Transparent" BorderBrush="Transparent" Foreground="White"/>
                <Button x:Name="btnSettings" Content="⚙️" Height="40" Cursor="Hand"
                        Background="Transparent" BorderBrush="Transparent" Foreground="White"/>
            </StackPanel>
            
            <!-- Foldertree -->
            <Grid Grid.Column="1" Background="#262422"></Grid>
            
            <!-- GridSplitter -->
            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="#262422"/>
            
            <!-- Workspace -->
            <Grid Grid.Column="3" Background="#302E2B"></Grid>
        </Grid>
    </Grid>
</Window>