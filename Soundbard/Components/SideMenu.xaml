<UserControl
    x:Class="Soundbard.Components.SideMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Soundbard.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Width="40" Background="#FF1F1F1F">
        <Button
            x:Name="btnSave"
            Height="40"
            Click="Save_Click"
            Content="💾"
            Style="{StaticResource SideMenuButton}" />
        <Button
            x:Name="btnLoad"
            Height="40"
            Click="Load_Click"
            Content="📂"
            Style="{StaticResource SideMenuButton}" />
        <Button
            x:Name="btnSettings"
            Height="40"
            Content="⚙️"
            Style="{StaticResource SideMenuButton}" />
    </StackPanel>

</UserControl>
