<UserControl
    x:Class="Soundbard.Components.TrackCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Soundbard.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="140"
    d:DesignWidth="210"
    mc:Ignorable="d">
    <Border
        Width="210"
        Height="140"
        Background="#262422"
        BorderBrush="red"
        BorderThickness="1"
        CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />
                <RowDefinition Height="10*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                BorderBrush="gray"
                BorderThickness="0,0,0,1" />
            <Grid />
            <Border
                Grid.Row="2"
                BorderBrush="gray"
                BorderThickness="0,1,0,0" />

        </Grid>
    </Border>
</UserControl>
