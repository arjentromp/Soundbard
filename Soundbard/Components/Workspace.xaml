<UserControl
    x:Class="Soundbard.Components.Workspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Soundbard.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer Background="#302E2B" VerticalScrollBarVisibility="Auto">
        <WrapPanel Margin="10" Orientation="Horizontal">
            <!--  Hardcoded track cards for now  -->
            <local:TrackCard Margin="8" />
            <local:TrackCard Margin="8" />
            <local:TrackCard Margin="8" />
            <!--  The + button always sits after the last card  -->
            <Grid
                Width="280"
                Height="180"
                Margin="8">
                <Rectangle
                    Fill="Transparent"
                    RadiusX="10"
                    RadiusY="10"
                    Stroke="Orange"
                    StrokeDashArray="4,3"
                    StrokeThickness="2" />
                <Button
                    VerticalContentAlignment="center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="+"
                    Cursor="Hand"
                    FontSize="50"
                    FontWeight="Bold"
                    Foreground="Orange" />
            </Grid>
        </WrapPanel>
    </ScrollViewer>
</UserControl>
