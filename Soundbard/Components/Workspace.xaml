<UserControl
    x:Class="Soundbard.Components.Workspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Soundbard.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer Background="#302E2B" VerticalScrollBarVisibility="Auto">
        <WrapPanel Margin="10" Orientation="Horizontal">

            <!--  Hardcoded track cards for now  -->
            <local:TrackCard Margin="8" />
            <local:TrackCard Margin="8" />
            <local:TrackCard Margin="8" />

            <!--  The + button always sits after the last card  -->
            <Border
                Width="210"
                Height="140"
                Margin="8"
                Background="Transparent"
                BorderBrush="Orange"
                BorderThickness="1"
                CornerRadius="10">
                <Button
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="+"
                    Cursor="Hand"
                    FontSize="28"
                    Foreground="orange" />
            </Border>
        </WrapPanel>
    </ScrollViewer>
</UserControl>
