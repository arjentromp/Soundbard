<UserControl
    x:Class="Soundbard.Components.Workspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Soundbard.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:TrackDataTemplateSelector x:Key="TrackSelector">
            <local:TrackDataTemplateSelector.TrackTemplate>
                <DataTemplate>
                    <local:TrackCard Margin="8" DataContext="{Binding}" />
                </DataTemplate>
            </local:TrackDataTemplateSelector.TrackTemplate>
            <local:TrackDataTemplateSelector.AddButtonTemplate>
                <DataTemplate>
                    <Button
                        Width="280"
                        Height="180"
                        Margin="8"
                        Command="{Binding DataContext.AddTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Content="+"
                        FontSize="28"
                        Style="{StaticResource AddTrackButton}" />
                </DataTemplate>
            </local:TrackDataTemplateSelector.AddButtonTemplate>
        </local:TrackDataTemplateSelector>
    </UserControl.Resources>

    <ScrollViewer Background="#302E2B" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemTemplateSelector="{StaticResource TrackSelector}" ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Margin="10" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </ScrollViewer>
</UserControl>